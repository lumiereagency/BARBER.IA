{
  "name": "@barber/db",
  "version": "0.1.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "psql": "dotenv -e ../../.env -- prisma db execute --stdin",
    "typecheck": "tsc --noEmit",
    "test:guarantees": "dotenv -e ../../.env -- node tests/guarantees.test.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "dotenv-cli": "^7.4.2",
    "pg": "^8.23.0",
    "prisma": "^5.22.0",
    "typescript": "^5.6.2"
  }
}
