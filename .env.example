# Cópia para .env no desenvolvimento. Nunca commitar segredos reais.

# --- Aplicação ---
APP_BASE_URL="http://localhost:3000"
NODE_ENV="development"

# --- Banco e cache ---
DATABASE_URL="postgresql://barber:barber@localhost:5432/barber_dev"
REDIS_URL="redis://localhost:6379"

# --- Segredos ---
# Assina sessões da equipe
AUTH_SECRET=""
# Deriva o HMAC dos tokens de gestão (/a/{token}), vaga e hold.
# Trocar esta chave invalida todos os links já enviados aos clientes.
TOKEN_HMAC_SECRET=""
# Cifra as credenciais de integração (AES-256-GCM), 32 bytes em base64.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Perder esta chave torna as credenciais guardadas ilegíveis e obriga cada
# profissional a reconectar o Google — nunca a gere de novo em produção.
ENCRYPTION_KEY=""
# Alternativa para instalações com cofre externo: referência à chave lá dentro.
# Fica vazio quando ENCRYPTION_KEY é usada.
ENCRYPTION_KEY_REF=""

# --- Armazenamento de objetos (logos, fotos) ---
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Google Calendar (saída apenas na V1) ---
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
GOOGLE_OAUTH_REDIRECT_URI=""

# --- OTP / e-mail (decisão #19.2 pendente: provedor de SMS) ---
# Vazio: em desenvolvimento o código vai para o log; em produção a aplicação
# se recusa a subir esse caminho, para não parecer que enviou e não enviar.
# "log": opt-in explícito para CI e homologação, que rodam o build de produção
# e precisam do fluxo inteiro. Nunca para clientes reais.
SMS_PROVIDER=""
SMS_PROVIDER_API_KEY=""
EMAIL_PROVIDER=""
EMAIL_PROVIDER_API_KEY=""
EMAIL_FROM=""

# --- Cobrança da assinatura (decisão #19.3 pendente: provedor) ---
BILLING_PROVIDER=""
BILLING_API_KEY=""
BILLING_WEBHOOK_SECRET=""

# --- Serviço WhatsApp isolado (opcional, fora do lançamento) ---
WHATSAPP_SERVICE_URL=""
WHATSAPP_SERVICE_INTERNAL_SECRET=""

# --- Observabilidade ---
SENTRY_DSN=""

# --- Fallbacks (a barbearia sempre define o próprio fuso) ---
DEFAULT_TIMEZONE="America/Sao_Paulo"
DEFAULT_LOCALE="pt-BR"
