// Schema de dados do BARBER SaaS — modela as entidades e regras confirmadas
// em docs/product-scope-part1.md e docs/architecture.md.
//
// Observação: a constraint que impede dois agendamentos CONFIRMED do mesmo
// profissional se sobreporem (seção 8 da Parte 1) não é expressável em
// Prisma puro (EXCLUDE USING gist do Postgres) — é adicionada via SQL em
// uma migration própria (ver prisma/migrations/.../migration.sql).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Plataforma / Superadmin
// ---------------------------------------------------------------------------

model Plan {
  id         String   @id @default(cuid())
  name       String // "Essencial", "Pro" — nomes/preços configuráveis, não fixos em código
  priceCents Int
  currency   String   @default("BRL")
  features   Json // ex.: { smartAgenda: true, waitlist: true, baileys: true, advancedReports: true }
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  subscriptions Subscription[]
}

model PlatformAdminUser {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now()) @db.Timestamptz(3)

  auditLogs AuditLog[]
}

model Coupon {
  id             String    @id @default(cuid())
  code           String    @unique
  discountType   String // PERCENT | FIXED
  discountValue  Int
  maxRedemptions Int?
  redeemedCount  Int       @default(0)
  expiresAt      DateTime? @db.Timestamptz(3)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
}

model AuditLog {
  id                 String             @id @default(cuid())
  actor              PlatformAdminUser? @relation(fields: [actorId], references: [id])
  actorId            String?
  action             String // ex.: "IMPERSONATION_VIEW_START"
  targetBarbershop   Barbershop?        @relation(fields: [targetBarbershopId], references: [id])
  targetBarbershopId String?
  metadata           Json?
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
}

// ---------------------------------------------------------------------------
// Barbearia (tenant) e assinatura
// ---------------------------------------------------------------------------

model Barbershop {
  id                      String           @id @default(cuid())
  slug                    String           @unique
  name                    String
  timezone                String           @default("America/Sao_Paulo")
  whatsappNumber          String? // número de contato exibido nos botões manuais
  holdDurationMinutes     Int              @default(5)
  minNoticeBookingMinutes Int              @default(0)
  maxBookingWindowDays    Int              @default(60)
  minNoticeCancelMinutes  Int              @default(0) // decisão #5 da Parte 1
  status                  BarbershopStatus @default(ACTIVE)
  createdAt               DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime         @updatedAt @db.Timestamptz(3)

  staffUsers          StaffUser[]
  professionals       Professional[]
  services            Service[]
  barbershopCustomers BarbershopCustomer[]
  appointments        Appointment[]
  promotions          Promotion[]
  waitlistEntries     WaitlistEntry[]
  smartSlotLinks      SmartSlotLink[]
  integrations        IntegrationStatus[]
  subscription        Subscription?
  auditLogs           AuditLog[]
}

enum BarbershopStatus {
  ACTIVE
  PAST_DUE
  SUSPENDED
}

model Subscription {
  id                 String             @id @default(cuid())
  barbershop         Barbershop         @relation(fields: [barbershopId], references: [id])
  barbershopId       String             @unique
  plan               Plan               @relation(fields: [planId], references: [id])
  planId             String
  status             SubscriptionStatus @default(ACTIVE)
  billingProvider    String             @default("stripe") // decisão #8 da Parte 1 — plugável
  externalCustomerId String?
  currentPeriodEnd   DateTime?          @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(3)
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

// ---------------------------------------------------------------------------
// Equipe (login por e-mail/senha — decisão #2 da Parte 1)
// ---------------------------------------------------------------------------

model StaffUser {
  id           String     @id @default(cuid())
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])
  barbershopId String
  name         String
  email        String
  passwordHash String
  role         StaffRole
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @db.Timestamptz(3)

  professional Professional?

  @@unique([barbershopId, email])
}

enum StaffRole {
  OWNER
  RECEPTION
  PROFESSIONAL
}

model Professional {
  id           String     @id @default(cuid())
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])
  barbershopId String
  staffUser    StaffUser  @relation(fields: [staffUserId], references: [id])
  staffUserId  String     @unique // decisão #3: sem conta global de equipe, 1 vínculo = 1 login
  displayName  String
  photoUrl     String?
  active       Boolean    @default(true)

  weeklySchedules    ProfessionalWeeklySchedule[]
  scheduleExceptions ProfessionalScheduleException[]
  services           ProfessionalService[]
  appointments       Appointment[]
  integrations       IntegrationStatus[]
}

model ProfessionalWeeklySchedule {
  id             String       @id @default(cuid())
  professional   Professional @relation(fields: [professionalId], references: [id])
  professionalId String
  weekday        Int // 0=domingo ... 6=sábado
  startTime      String // "09:00"
  endTime        String // "18:00"
}

model ProfessionalScheduleException {
  id             String            @id @default(cuid())
  professional   Professional      @relation(fields: [professionalId], references: [id])
  professionalId String
  date           DateTime          @db.Date
  type           ScheduleException // BLOCK (folga/bloqueio) ou EXTRA (janela adicional)
  startTime      String?
  endTime        String?
  reason         String?
}

enum ScheduleException {
  BLOCK
  EXTRA
}

// ---------------------------------------------------------------------------
// Serviços
// ---------------------------------------------------------------------------

model Service {
  id              String     @id @default(cuid())
  barbershop      Barbershop @relation(fields: [barbershopId], references: [id])
  barbershopId    String
  name            String // combos (ex.: "Corte + Barba") são cadastrados como Service próprio — decisão #4
  durationMinutes Int
  bufferMinutes   Int        @default(0)
  priceCents      Int
  active          Boolean    @default(true)

  professionals ProfessionalService[]
  appointments  Appointment[]
}

model ProfessionalService {
  professional   Professional @relation(fields: [professionalId], references: [id])
  professionalId String
  service        Service      @relation(fields: [serviceId], references: [id])
  serviceId      String

  @@id([professionalId, serviceId])
}

// ---------------------------------------------------------------------------
// Cliente: identidade global (Customer) x relação por barbearia (BarbershopCustomer)
// — seção 10.2 da Parte 1
// ---------------------------------------------------------------------------

model Customer {
  id           String    @id @default(cuid())
  phone        String?   @unique // canal principal de autenticação (OTP por SMS — decisão #1)
  email        String?   @unique // fallback de autenticação
  name         String
  anonymizedAt DateTime? @db.Timestamptz(3) // preenchido no encerramento de conta (decisão #7 — LGPD)
  createdAt    DateTime  @default(now()) @db.Timestamptz(3)

  barbershopLinks BarbershopCustomer[]
}

model BarbershopCustomer {
  id            String     @id @default(cuid())
  barbershop    Barbershop @relation(fields: [barbershopId], references: [id])
  barbershopId  String
  customer      Customer?  @relation(fields: [customerId], references: [id])
  customerId    String? // nulo até o cliente criar conta e vincular o histórico
  name          String
  whatsapp      String
  whatsappOptIn Boolean    @default(false) // consentimento promocional por canal — seção 10.2
  emailOptIn    Boolean    @default(false)
  smsOptIn      Boolean    @default(false)
  createdAt     DateTime   @default(now()) @db.Timestamptz(3)

  appointments    Appointment[]
  waitlistEntries WaitlistEntry[]

  @@unique([barbershopId, customerId])
  @@index([barbershopId, whatsapp])
}

// ---------------------------------------------------------------------------
// Agendamento — máquina de estados da seção 11 da Parte 1
// ---------------------------------------------------------------------------

model Appointment {
  id                   String             @id @default(cuid())
  barbershop           Barbershop         @relation(fields: [barbershopId], references: [id])
  barbershopId         String
  professional         Professional       @relation(fields: [professionalId], references: [id])
  professionalId       String
  service              Service            @relation(fields: [serviceId], references: [id])
  serviceId            String
  barbershopCustomer   BarbershopCustomer @relation(fields: [barbershopCustomerId], references: [id])
  barbershopCustomerId String

  startsAt      DateTime          @db.Timestamptz(3)
  endsAt        DateTime          @db.Timestamptz(3)
  status        AppointmentStatus @default(HOLD)
  holdExpiresAt DateTime?         @db.Timestamptz(3) // aplicável somente enquanto status = HOLD

  manageToken String            @unique @default(cuid()) // usado em /a/{token} — seção 9
  source      AppointmentSource @default(ONLINE)

  rescheduledFrom   Appointment? @relation("Reschedule", fields: [rescheduledFromId], references: [id])
  rescheduledFromId String?      @unique
  rescheduledTo     Appointment? @relation("Reschedule")

  promotion   Promotion? @relation(fields: [promotionId], references: [id])
  promotionId String?

  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  events              AppointmentEvent[]
  waitlistFulfillment WaitlistEntry?
  smartSlotLink       SmartSlotLink?

  // Ver migration.sql: EXCLUDE USING gist (professional_id WITH =, tstzrange(starts_at, ends_at) WITH &&)
  // WHERE (status = 'CONFIRMED') — impede sobreposição real no mesmo profissional (seção 8).
  @@index([barbershopId, professionalId, startsAt])
  @@index([status, holdExpiresAt])
}

enum AppointmentStatus {
  HOLD
  CONFIRMED
  CANCELLED_BY_CUSTOMER
  CANCELLED_BY_SHOP
  COMPLETED
  NO_SHOW
}

enum AppointmentSource {
  ONLINE // wizard público
  MANUAL // criado pela equipe na Agenda
  WAITLIST // originado de uma entrada da lista de espera
  SMART_SLOT // originado de um link de vaga (/vaga/{token})
}

model AppointmentEvent {
  id            String      @id @default(cuid())
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  appointmentId String
  type          String // ex.: "CREATED", "CONFIRMED", "CANCELLED", "RESCHEDULED", "STATUS_CHANGED"
  actorType     ActorType
  actorId       String?
  metadata      Json?
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
}

enum ActorType {
  CUSTOMER
  STAFF
  SYSTEM
}

// ---------------------------------------------------------------------------
// Promoções — seção 15
// ---------------------------------------------------------------------------

model Promotion {
  id                      String     @id @default(cuid())
  barbershop              Barbershop @relation(fields: [barbershopId], references: [id])
  barbershopId            String
  title                   String
  description             String
  startsAt                DateTime   @db.Timestamptz(3)
  endsAt                  DateTime   @db.Timestamptz(3)
  eligibleWeekdays        Int[] // 0-6
  eligibleServiceIds      String[]
  eligibleProfessionalIds String[]
  usageLimit              Int?
  usageCount              Int        @default(0)
  active                  Boolean    @default(true)
  createdAt               DateTime   @default(now()) @db.Timestamptz(3)

  appointments Appointment[]
}

// ---------------------------------------------------------------------------
// Lista de espera — seção 16 (Pro)
// ---------------------------------------------------------------------------

model WaitlistEntry {
  id                     String             @id @default(cuid())
  barbershop             Barbershop         @relation(fields: [barbershopId], references: [id])
  barbershopId           String
  barbershopCustomer     BarbershopCustomer @relation(fields: [barbershopCustomerId], references: [id])
  barbershopCustomerId   String
  serviceId              String?
  professionalId         String?
  preferredDate          DateTime?          @db.Date
  timeRangeStart         String? // "09:00"
  timeRangeEnd           String? // "12:00"
  status                 WaitlistStatus     @default(WAITING)
  rankScore              Float? // pontuação explicável reaproveitada da Agenda Inteligente — decisão #10
  rankReasons            Json?
  fulfilledAppointment   Appointment?       @relation(fields: [fulfilledAppointmentId], references: [id])
  fulfilledAppointmentId String?            @unique
  createdAt              DateTime           @default(now()) @db.Timestamptz(3)

  @@index([barbershopId, status])
}

enum WaitlistStatus {
  WAITING
  NOTIFIED
  FULFILLED
  EXPIRED
}

// ---------------------------------------------------------------------------
// Agenda Inteligente — link de vaga /vaga/{token}, seção 13.3
// ---------------------------------------------------------------------------

model SmartSlotLink {
  id                   String       @id @default(cuid())
  barbershop           Barbershop   @relation(fields: [barbershopId], references: [id])
  barbershopId         String
  professionalId       String
  eligibleServiceIds   String[]
  startsAt             DateTime     @db.Timestamptz(3)
  endsAt               DateTime     @db.Timestamptz(3)
  token                String       @unique @default(cuid())
  expiresAt            DateTime     @db.Timestamptz(3)
  claimedAppointment   Appointment? @relation(fields: [claimedAppointmentId], references: [id])
  claimedAppointmentId String?      @unique
  createdAt            DateTime     @default(now()) @db.Timestamptz(3)
}

// ---------------------------------------------------------------------------
// Integrações (status visível, nunca crítico — seções 17 e 18)
// ---------------------------------------------------------------------------

model IntegrationStatus {
  id             String            @id @default(cuid())
  barbershop     Barbershop        @relation(fields: [barbershopId], references: [id])
  barbershopId   String
  professional   Professional?     @relation(fields: [professionalId], references: [id]) // Google Calendar é por profissional
  professionalId String?
  type           IntegrationType
  status         IntegrationHealth @default(DISCONNECTED)
  metadata       Json?
  updatedAt      DateTime          @updatedAt @db.Timestamptz(3)

  @@unique([barbershopId, professionalId, type])
}

enum IntegrationType {
  GOOGLE_CALENDAR
  WHATSAPP_BAILEYS
}

enum IntegrationHealth {
  CONNECTED
  DISCONNECTED
  ERROR
}

// ---------------------------------------------------------------------------
// Outbox — efeitos assíncronos (WhatsApp, Google Calendar, lembretes) nunca
// bloqueiam a escrita do agendamento (princípio da seção 3 / arquitetura §3)
// ---------------------------------------------------------------------------

model OutboxJob {
  id        String       @id @default(cuid())
  type      String // ex.: "SYNC_GOOGLE_CALENDAR", "SEND_REMINDER", "NOTIFY_WAITLIST"
  payload   Json
  status    OutboxStatus @default(PENDING)
  attempts  Int          @default(0)
  runAfter  DateTime     @default(now()) @db.Timestamptz(3)
  lastError String?
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  @@index([status, runAfter])
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}
