{
  "name": "barber-saas",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm --filter @barber/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "worker": "pnpm --filter @barber/worker start",
    "db:generate": "pnpm --filter @barber/db generate",
    "db:migrate": "pnpm --filter @barber/db migrate",
    "db:studio": "pnpm --filter @barber/db studio",
    "infra:up": "docker compose -f infra/docker/docker-compose.dev.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.dev.yml down",
    "test": "pnpm --filter @barber/domain test && pnpm --filter @barber/db test:guarantees"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.6.2"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "prisma",
      "esbuild"
    ]
  }
}
